# ============================================================================
# METROPOLIS PROPIEDADES - VARIABLES DE ENTORNO
# Supabase + Next.js App Router
# ============================================================================

# 1. Supabase Project Configuration (Obtenlas en tu Dashboard de Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# 2. Supabase Service Role Key (Solo para el servidor backend, nunca se expone al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key-aqui

# 3. URL de la aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000
